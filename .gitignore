# 运行时与虚拟环境
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.tmp
.*.swp

# flock 锁文件（`.MEMORY.md.lock`）是运行时垃圾，不该进版本库
.*.lock

# 凭据：里面有真实 API_KEY，永远不进仓库
.env
.env.local
*.env.secret
storage/soul/*.key
**/credentials*

# 记忆资产里「可重建 / 体积大」的部分：逐轮日志、人格备份、工具产物
# 长期记忆（SOUL.md / USER.md / MEMORY.md / RELATIONS.md / CLAWD.md / persona.json / presets）照旧跟踪
storage/data/users/*/logs/
storage/data/users/*/state.json
storage/data/users/*/backups/
storage/data/users/*/artifacts/
storage/logs/
# 守护进程的运行痕迹（pidfile 与 server.out）——机器本地状态，不该进版本库
storage/run/

# 裸机协议端的工作目录（含鉴权串与主程序软链，机器本地状态）
onebot/

# NapCat 配置留档里带着真实鉴权串，和 .env 同级敏感，不进版本库
scripts/qq/napcat_config.json

# 她自己的心境记事与审批工单：私有运行数据，不进主仓库（灵魂资产走 ClawdSoul 独立分支）
storage/soul/MOOD.md
storage/run/approvals/
storage/data/users/*/*.bak-*

# 实验残留的 sqlite 与本地跑图产物：不是资产，不进版本库
guild1.db
guild1.db-shm
guild1.db-wal
vibe_images/

# 她的草稿工位是运行时数据（查来的材料、算一半的数），不进版本库
storage/sandbox/
