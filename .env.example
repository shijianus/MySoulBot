# ===== 主对话模型（任意 OpenAI 兼容接口）=====
# 官方 OpenAI
# BASE_URL=https://api.openai.com/v1
# 硅基流动 / DeepSeek / 通义 / ollama+openai插件 / lmstudio / one-api 等均可
BASE_URL=https://api.openai.com/v1
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MODEL=gpt-4o-mini

# 生成参数
TEMPERATURE=0.85
TOP_P=1.0
MAX_TOKENS=800
FREQUENCY_PENALTY=0.0
REQUEST_TIMEOUT=120
MAX_RETRIES=2

# ===== 记忆抽取（建议用便宜/本地小模型，留空则复用上面的配置）=====
EXTRACTOR_ENABLED=true
EXTRACTOR_MODEL=
EXTRACTOR_BASE_URL=
EXTRACTOR_API_KEY=
EXTRACTOR_TIMEOUT=60
EXTRACTOR_MAX_TOKENS=400
EXTRACTOR_LOOKBACK_TURNS=6
EXTRACTOR_MAX_FACTS=4
# 双轨抽取：一次调用同时产出【事实→MEMORY.md】与【关系动态→RELATIONS.md】
# REFLECTION_ENABLED=false 就只记事实，不再沉淀「怎么跟他相处」
REFLECTION_ENABLED=true
RELATIONS_MAX_ENTRIES=40

# ===== 双层灵魂：ClawdSoul（深层内核）+ Persona（外在人格）=====
# CLAWD_ENABLED=false 会摘掉 LAYER 0，只剩人格与硬约束（不建议）
CLAWD_ENABLED=true
CLAWD_MAX_CHARS=4500

# ===== 客户端观感 =====
# IMMERSIVE=true 主气泡只输出角色说的话；false 会恢复「◍ 角色 ▸」这类标签
IMMERSIVE=true
# CHAT_MODE=group 直接以群聊启动（控制台与所有参数指令锁死）；solo 为 1V1
CHAT_MODE=solo
# DIAGNOSTICS=true 才显示错误细节、hint 与同步步骤（等价 /panel debug on）
DIAGNOSTICS=false

# ===== 工具生态 =====
TOOLS_ENABLED=true
# NATIVE：接口支持 function calling 时用原生下单；不支持会自动退回行内暗号
TOOL_NATIVE_CALLING=true
TOOL_MAX_ROUNDS=3
TOOL_TIMEOUT=45
TOOL_AUDIT=true
# 网页：抓取字节上限、超时、喂给模型的正文字数
WEB_ENABLED=true
WEB_MAX_BYTES=2000000
WEB_TIMEOUT=20
WEB_MAX_CHARS=6000
# 画图：stub=本地占位图（会明说是占位）；openai=走 /images/generations；none=不挂这个能力
IMAGE_PROVIDER=stub
IMAGE_MODEL=
IMAGE_SIZE=1024x1024
# 快照：auto=按 playwright→截图命令→文字快照 依次探测
SNAPSHOT_PROVIDER=auto

# ===== 记忆资产体积与远端同步（GitHub 单文件 100MB 硬线）=====
# 明文日志保留天数，更早的整份 gzip 进 storage/data/users/<id>/logs/archive/
LOG_KEEP_DAYS=7
LOG_MAX_FILE_BYTES=4194304
LOG_MAX_TOTAL_BYTES=33554432
ARCHIVE_KEEP_DAYS=120
DOC_MAX_BYTES=8388608
# 事实/关系动态条数超过它就下沉到归档（搬家，不删除）
MEMORY_COMPACT_THRESHOLD=800
# 同步闸门：超过这个体积的文件会被踢出提交
GIT_SAFE_FILE_BYTES=20971520
SYNC_REMOTE_URL=git@github.com:shijianus/MySoulBot.git
SYNC_REMOTE_BRANCH=main

EXTRACTOR_MAX_FACTS=4

# ===== Prompt 分层预算 =====
CONTEXT_MAX_TURNS=12
SOUL_MAX_CHARS=6000
USER_MAX_CHARS=2500
MEMORY_MAX_ENTRIES=60

# ===== 存储与运行 =====
STORAGE_DIR=storage
DEFAULT_USER_ID=guest
PERSIST_TRANSCRIPT=true
LOG_LEVEL=INFO
