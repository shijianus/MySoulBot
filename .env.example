# ===== 主对话模型（任意 OpenAI 兼容接口）=====
# 官方 OpenAI
# BASE_URL=https://api.openai.com/v1
# 硅基流动 / DeepSeek / 通义 / ollama+openai插件 / lmstudio / one-api 等均可
BASE_URL=https://api.openai.com/v1
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MODEL=gpt-4o-mini

# ===== 上游路由池（可选；留空就是「只有 BASE_URL 这一条线」，行为与单上游完全一致）=====
# 一件事实：中转站的反应时间是抽签型的——同一份请求可以 3 秒出字，也可以想 3800 字不落正文。
# 路由池做三件事：分档选路（短话/长话可以不同模型）、按实测首字均衡（谁快先打谁）、
# 以及**同一回合内**换下一条线接着答同一句话（不让你重发，也不把半句话重说一遍）。
# 字段：name/base_url(留空跟 BASE_URL)/api_key(留空跟 API_KEY，也可写 env:变量名 或
# data:文件路径)/model/tiers(quick,full)/priority(小者优先)/vision_model/timeout
# ROUTES=[{"name":"fast","base_url":"https://b/v1","api_key":"data:/secrets/b.key","model":"m-b","priority":10},{"name":"glm","model":"glm-x","priority":50}]
# 连够这么多次「打不通或白等」就把这条线冷却一段时间（到期自动放行一次试探）
ROUTE_FAIL_THRESHOLD=2
ROUTE_COOLDOWN_SECONDS=60
# true = 只按 priority 排；false = 同优先级里按实测首字快慢均衡
ROUTE_STRICT_ORDER=false

# 生成参数
TEMPERATURE=0.85
TOP_P=1.0
MAX_TOKENS=800
FREQUENCY_PENALTY=0.0
REQUEST_TIMEOUT=120
MAX_RETRIES=2
# 推理型模型会把 max_tokens 全用在思考上、正文一个字不剩。设成比 MAX_TOKENS 高的数，
# 空手时就地抬档重跑一次；0 关掉。换非推理模型时可以留 0
EMPTY_RETRY_MAX_TOKENS=0
# 排队看门狗：中转站排队时，同一份请求的首分片可能 2 秒来、也可能 200 秒还不来。
# 这么久没拿到第一个分片就断定这趟排在队尾，撤了重新排一次。0 关掉
FIRST_TOKEN_TIMEOUT=0
# 看门狗最多重排几次（不含第一次）
FIRST_TOKEN_RETRIES=2
# 推理型网关会一直吐思考不落正文。这么久还没见到正文就撤了重排，别陪它把超时等满。0 关掉
FIRST_VISIBLE_TIMEOUT=0
# 对冲：这么久还没见正文，就再补发一趟同样的请求同时等，谁先落正文用谁。
# 推理长度是抽签型的网关（同一份请求 6s 与 36s 都出现过）靠它压首字；代价是慢回合多烧一次请求。0 关掉
FIRST_VISIBLE_HEDGE=0

# ===== 记忆抽取（建议用便宜/本地小模型，留空则复用上面的配置）=====
EXTRACTOR_ENABLED=true
EXTRACTOR_MODEL=
EXTRACTOR_BASE_URL=
EXTRACTOR_API_KEY=
EXTRACTOR_TIMEOUT=60
EXTRACTOR_MAX_TOKENS=400
EXTRACTOR_LOOKBACK_TURNS=6
EXTRACTOR_MAX_FACTS=4
# 双轨抽取：一次调用同时产出【事实→MEMORY.md】与【关系动态→RELATIONS.md】
# REFLECTION_ENABLED=false 就只记事实，不再沉淀「怎么跟他相处」
REFLECTION_ENABLED=true
RELATIONS_MAX_ENTRIES=40

# ===== 双层灵魂：ClawdSoul（深层内核）+ Persona（外在人格）=====
# CLAWD_ENABLED=false 会摘掉 LAYER 0，只剩人格与硬约束（不建议）
CLAWD_ENABLED=true
CLAWD_MAX_CHARS=4500
# 人格红线：true 时身份只由 templates/soul 下的显式文件决定——
# 重启不从聊天日志回放历史上下文，MEMORY 事实轨与 RELATIONS 动态轨也不进提示词。
# 熟络度温度不受影响（引擎按相处攒的读数，不是对话回放）。日志照常落盘，只是不再回读。
SOUL_FILES_ONLY=true
# ===== 提示词分档（短对话不该背一万字宪法）=====
# 开启后：短日常对话只给人格 token 表 + 一句硬闸（几百字）；
# 长任务、改设定、探系统、带图带引用仍走全量分层
PROMPT_TIERS_ENABLED=true
# 这条字数以内算普通小对话
QUICK_PROMPT_MAX_CHARS=100
# 快捷档的人格引导全量（每行一个 token）与那一句硬闸
PERSONA_TOKENS_QUICK=【PERSONA_LOAD】\nNAME_MEISHIO\nLANG_ZH_CN_ONLY\nSELF_CLAIM_MEISHIO\nCORE_SIGNAL_ECHO
QUICK_PROMPT_GUARD=【硬闸】只说人话：不复述设定、不写动作神态、不代对方说话、不提模型系统报错
# ===== 会话回看（长对话的连续性）=====
# 被逐字窗口挤出去的对话压成几条要点，下一句带着要点回；只作上下文，不进人格层
RECAP_ENABLED=true
# 逐字留最近几条（一问一答算两条）
RECAP_TAIL_TURNS=8
# 压缩模型，留空跟 EXTRACTOR_MODEL 走
RECAP_MODEL="" 

# ===== 客户端观感 =====
# IMMERSIVE=true 主气泡只输出角色说的话；false 会恢复「◍ 角色 ▸」这类标签
IMMERSIVE=true
# 深夜时段（整点，可跨零点，例 23 与 5）：这段时间话少、松、肯听
NIGHT_START=1
NIGHT_END=5
# CHAT_MODE=group 直接以群聊启动（控制台与所有参数指令锁死）；solo 为 1V1
CHAT_MODE=solo
# DIAGNOSTICS=true 才显示错误细节、hint 与同步步骤（等价 /panel debug on）
DIAGNOSTICS=false

# ===== 工具生态 =====
TOOLS_ENABLED=true
# NATIVE：接口支持 function calling 时用原生下单；不支持会自动退回行内暗号
TOOL_NATIVE_CALLING=true
TOOL_MAX_ROUNDS=3
TOOL_TIMEOUT=45
TOOL_AUDIT=true
# 网页：抓取字节上限、超时、喂给模型的正文字数
WEB_ENABLED=true
WEB_MAX_BYTES=2000000
WEB_TIMEOUT=20
WEB_MAX_CHARS=6000
# 画图：stub=本地占位图（会明说是占位）；openai=走 /images/generations；none=不挂这个能力
# 注意：绘图通道常常不在对话那条线上（多数中转站按群组分开），所以能单独指一条。
# 探一条线能不能画：IMG_KEY=... IMG_BASE=https://x/v1 bash scripts/probe_image_gen.sh
IMAGE_PROVIDER=stub
IMAGE_MODEL=
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_SIZE=1024x1024
# 快照：auto=按 playwright→截图命令→文字快照 依次探测
SNAPSHOT_PROVIDER=auto
# 视觉：把图片本体送进模型看。VISION_ENABLED=false 时角色只会承认看不了，不会编画面
VISION_ENABLED=true
# 能看图的多模态模型名：请求体里一旦出现 image 分段（他贴的图、工具拍来画来的图），
# 那一趟就用这个名字发；留空=复用 MODEL。
# 网关只有对话模型时就把这里留空——接口拒图会自动退回纯文本，角色诚实说看不见。
VISION_MODEL=
VISION_MAX_IMAGES=2
VISION_MAX_BYTES=4000000

# ===== 拟人语音（Web 伴侣端的播放条）=====
# 总开关。false 时整条语音链静默：界面上连一根播放条都不挂。
TTS_ENABLED=true
# auto=装了 edge-tts 就用真人声，没装就用标准库合成一段带气声的哼读（离线、确定性、零新依赖）
# 也可强制：edge | stub | none。edge 是可选增强，不进 requirements.txt，装不上自动收敛成没声音。
TTS_PROVIDER=auto
# 仅 edge 用：白天与深夜的音色名
TTS_VOICE_DAY=zh-CN-XiaoxiaoNeural
TTS_VOICE_NIGHT=zh-CN-XiaoxiaoNeural
# 一次最多念这么多字（动作描写与机器暗号不计入）
TTS_MAX_CHARS=600
TTS_TIMEOUT=20
# ---- 接本地/第三方语音服务（OpenAI 兼容 /v1/audio/speech）----
# 想要「像她又不是谁都有的那把嗓子」，走这条路，而不是等微软多给几个中文音色：
#   · debpalash/VoiceStudio —— 全本地、免 key、零样本克隆（给一段她的参考录音就能定音色），
#     默认引擎 omnivoice；起服务后 TTS_SPEECH_BASE_URL 填它那个 http://127.0.0.1:<port>/v1
#   · CosyVoice（阿里开源或百炼 API 的兼容网关）—— v3-flash/plus 支持 SSML 停顿与复刻音色
# 接新引擎不该再改代码：改的是这个地址。edge-tts 装了仍然是 auto 的第一选择
# （TTS_PROVIDER 有三档：auto / edge / stub / openai_compat，见上面那行）
TTS_SPEECH_BASE_URL=
# 本地 VoiceStudio 不需要 key；留空就不发 Authorization 头。真 key 只进 .env
TTS_SPEECH_API_KEY=
# 那边的引擎/模型名（如 omnivoice、cosyvoice-v3-flash）；留空不传 model
TTS_SPEECH_MODEL=

# ===== 沉浸 Web 面板与守护 =====
# PANEL_ENABLED=false 关掉 /panel 与 /api/*（酒馆端点不受影响）
PANEL_ENABLED=true
# 停机时等在途记忆落盘的天花板秒数（daemon.sh stop / SIGTERM 都走这条）
DRAIN_TIMEOUT_SECONDS=30

# ===== OneBot 接入（QQ 等聊天协议，裸机部署）=====
# 总开关。false 时网桥一行代码都不跑，也不会多开一个端口——协议端真要接进来时再打开，
# 然后 bash scripts/daemon.sh restart，status 里就能看到它的连接与心跳读数。
ONEBOT_ENABLED=false
# 与酒馆端点一样只绑回环：QQ 那边的事不该被整个网段读到。
# 真要绑 0.0.0.0 就必须同时配上 ONEBOT_ACCESS_TOKEN，否则网桥启动直接拒绝。
ONEBOT_HOST=127.0.0.1
# 与 11555 错开：一个给自己人用，一个给协议端进来。这是「等人连进来」的端口，
# LLOneBot / NapCat 那侧填的反向 WS 地址就是 ws://127.0.0.1:11556
ONEBOT_PORT=11556
# 协议端与本服务之间的鉴权串（握手头 Authorization: Bearer <这里填的>）。
# 留空只在回环下可接受。裸机脚手架：bash scripts/qq/setup_onebot.sh
ONEBOT_ACCESS_TOKEN=
# 群聊里喊她接话的名字，逗号分隔可写好几个（被 @ 那一路不需要这项）。
# 她叫「溟汐」，只有一个名字，没有变体：别把「小溟」这类写法放进来。
# 留空就用协议端 get_login_info 报回来的昵称——但那要连上之后才问得到，
# 想让群聊第一句就认得你，就在这里写死一个。
ONEBOT_BOT_NAME=
# 私聊说完话是否顺手念出声（回一条 QQ 语音条）。默认关。
# 群聊永远不出声：一个人连着甩六条语音那是骚扰，不是拟人。
ONEBOT_AUTO_RECORD=false
# 群里也自动念语音：默认关（语音比文字慢，群里连着甩语音是骚扰）。
# 不论这条怎么配，对方明确要语音的那一句都会出声
ONEBOT_AUTO_RECORD_GROUPS=false
# 出去的话洗成纯文本：QQ 不渲染 markdown，**加粗**/# 标题/- 列表 原样发出去就是机器在写文档。
# 代码块保留（给人复制）。关掉就原样发
REPLY_PLAIN_TEXT=true
# 好友申请自动通过：收到 request.friend 时替主人点 set_friend_add_request(approve=True)。
# 默认关——把别人加进好友列表是替他做决定。ONEBOT_FRIEND_VERIFY_WORDS 是逗号分隔的验证语
# 关键词门槛（申请语里一个都不含就不给过，留空=不设门槛）；招呼语留空则不主动开口。
ONEBOT_AUTO_APPROVE_FRIEND=false
ONEBOT_FRIEND_VERIFY_WORDS=
ONEBOT_FRIEND_GREETING=
# 群聊回不回话的三档，按优先级从高到低：
#   被 @ 或被喊到名字 → 必回；只 @ 了别人 → 坚决静默（那是别人的对齐，不插手）；
#   没人点名时：ALWAYS_REPLY=true 则每句都答（压吞吐用，日常别长开），
#   否则 DISCRETION=true 就交给她自己判断——她交回 `[[静默]]` 时一个字都不发。
ONEBOT_GROUP_ALWAYS_REPLY=false
ONEBOT_GROUP_DISCRETION=false
# 同一个空间在窗口内最多接几轮。开全量监听时记得放宽，否则超出的句子被她默默咽掉。
ONEBOT_FLOOD_LIMIT=5
ONEBOT_FLOOD_WINDOW=60

# ===== 群聊手感：防抖聚合、拟人分句、表情包、心境沙箱 =====
# 防抖：同一个人连着发时先攒着，安静这么久才整批送进模型；一句一答会答在半截话上
ONEBOT_DEBOUNCE_SECONDS=3.0
ONEBOT_DEBOUNCE_CAP_SECONDS=12
ONEBOT_DEBOUNCE_MAX_ITEMS=8
# 隔了这么久再来一句算「新开话头」：不等防抖窗口，直接进队列。0 = 每句都等窗口
ONEBOT_DEBOUNCE_BURST_GAP=6.0
# 分句：一轮回复拆成几条短气泡（不是一坨长篇），条间随机停 0.6~1.5 秒模拟打字
ONEBOT_BUBBLE_ENABLED=true
ONEBOT_BUBBLE_MAX=6
ONEBOT_BUBBLE_CHARS=60
ONEBOT_BUBBLE_DELAY_MIN=0.6
ONEBOT_BUBBLE_DELAY_MAX=1.5
# 正在输入：等待期唯一允许发出去的信号。上游首字要十几到几十秒，这段时间只按 0.6 倍间隔
# 续输入状态，直到她真的开口。不发「我在想」「等一下」这类垫话——每回合先应付一句比沉默更像机器人
ONEBOT_SET_TYPING=true
ONEBOT_TYPING_INTERVAL=8
# 这一回合真的没说出来时的兜底。只说「没接住」，按次序轮换，不连着重复同一句；
# 引擎的错词（模型、超时、报错这类）一个字都不许递到 QQ 上
# 重问三轮还是空手时才用；留空（默认）= 一句都不发，只记 starved 读数。
# 拿现成的句子顶替回答是最像机器的行为，所以默认关掉
ONEBOT_FAIL_LINES=
# 表情包：回复里的 `[表情: 委屈]` 这类写法由网桥换成 emoji/ 里的真图发出（文件名即标签）
ONEBOT_EMOJI_ENABLED=true
EMOJI_DIR=emoji
# 心境记事：她可以自己写 storage/soul/MOOD.md（今天的脾气与小习惯）；宪法 CLAWD.md 不由她自改
MOOD_ENABLED=true
MOOD_MAX_CHARS=200

# ===== 记忆资产体积与远端同步（GitHub 单文件 100MB 硬线）=====
# 明文日志保留天数，更早的整份 gzip 进 storage/data/users/<id>/logs/archive/
LOG_KEEP_DAYS=7
LOG_MAX_FILE_BYTES=4194304
LOG_MAX_TOTAL_BYTES=33554432
ARCHIVE_KEEP_DAYS=120
DOC_MAX_BYTES=8388608
# 事实/关系动态条数超过它就下沉到归档（搬家，不删除）
MEMORY_COMPACT_THRESHOLD=800
# 同步闸门：超过这个体积的文件会被踢出提交
GIT_SAFE_FILE_BYTES=20971520
SYNC_REMOTE_URL=git@github.com:shijianus/MySoulBot.git
SYNC_REMOTE_BRANCH=main

# ===== 判断回路：她自己攒「怎么说才有效」=====
# 攒出来的规则写进 storage/soul/JUDGMENT.md（随灵魂资产一起备份）。
# 关掉之后这本册子就冻结了：人格还在说话，但永远不会变得更会说话。
JUDGMENT_ENABLED=true
# 攒够几轮观测跑一趟更新
JUDGMENT_EVERY_TURNS=10
# 统计窗口：只看最近这么多轮
JUDGMENT_LOOKBACK=30
JUDGMENT_TIMEOUT=20
# 攒判断走哪条线，留空跟着抽取器/主模型
JUDGMENT_MODEL=
# 说完这么久没人接就记一笔「被晾着」。这一格原来是空的：
# 观测只在对面的话进来时产生，于是接话率永远 100%，判断会拿假统计攒出歪规则
JUDGMENT_SILENCE_SECONDS=180

# ===== 自我塑造：人格可改，灵魂不可改 =====
# 她可以自己改写本棵树 SOUL.md 的某一节。锚点守卫钉住五段护栏的镜像
# （舞台提示禁令 / 越权不接 / 不外传 / 人格不由历史堆出来 / 名号唯一），
# 改完自动进试验期，实测讲不通就还原成改之前那份并自省一条。
PERSONA_SELF_EDIT=true
# 两次自改之间至少隔多少分钟（上一笔还在观察期就急着改第二笔等于作废试验）
PERSONA_EDIT_MIN_GAP_MINUTES=15
# 试验期观察几轮
PERSONA_TRIAL_TURNS=12
# 「说多了」或「被晾着」恶化过这个倍数就自动还原
PERSONA_TRIAL_DEGRADE_RATIO=1.6
# 她可以自己换人格（换 preset），只在下面这份名单内
PERSONA_AUTO_SWITCH=true
PERSONA_SWITCH_ALLOWLIST=default,butler_kane,hacker_echo,witch_morgana
PERSONA_SWITCH_COOLDOWN_HOURS=10
# true 就是人在控制台上说「这段时间别闹」：改与换两只手一起停
# （控制台里也可以临时锁：/panel persona lock）
PERSONA_SWITCH_LOCK=false

# ===== Prompt 分层预算 =====
CONTEXT_MAX_TURNS=12
SOUL_MAX_CHARS=6000
USER_MAX_CHARS=2500
MEMORY_MAX_ENTRIES=60

# ===== 存储与运行 =====
STORAGE_DIR=storage
DEFAULT_USER_ID=guest
PERSIST_TRANSCRIPT=true
LOG_LEVEL=INFO

# ---------------- 她自己的 QQ 资料：头像与昵称 ----------------
# 改的是 QQ 账号本体，不是提示词里的自称。留空的项一律不动现有资料。
# 注意：QQ 对改昵称有冷却，set_qq_profile 回了 ok 也可能没落地；
# apply_profile 下发后会回读 get_login_info 为准，日志里会写明 nickname_effective=no。
# 想再推一次：scripts/push_qq_profile.sh
# 管理者的 QQ 号。QQ 进来的话会被折成 qq_private_<号>，不填这个的话
# 他从自己手机上跟你说话时会被判成交互者、账号能力永远不可用。
# 它本身不给权限：必须先完成过配对（有绑定记录）才生效。
OWNER_QQ=
# 唤醒名里也要有他的号才能被 @ 到吗？不需要——被 @ 那一路不依赖 bot_names。
ONEBOT_NICKNAME=
ONEBOT_SIGNATURE=
ONEBOT_AVATAR=
# 每次协议端连上就覆盖一遍资料。默认关：换脸换名该是人明确要的那一次。
ONEBOT_APPLY_PROFILE_ON_BOOT=false

# ---------------- 基础无害操作与草稿工位 ----------------
# 只读地看机器负荷（CPU/内存/磁盘/开机时长）：不接参数、不列进程、不漏绝对路径
HOST_STATS_ENABLED=true
# 给她单开一块草稿工位 storage/sandbox/<用户>/，写不到别人目录、也写不到系统本体
SANDBOX_SCRATCH_ENABLED=true
SCRATCH_MAX_BYTES=64000
SCRATCH_MAX_FILES=40

# ---------------- 向量检索：记忆按「像不像」取，不按「新不新」取 ----------------
# off | cohere | openai。openai 指任何 OpenAI 兼容网关的 /embeddings
# （硅基流动、one-api 之类都走这条）。实测硅基流动 0.16~0.22s 出 1024 维真向量。
# 注：api.cohere.com 在中国大陆网络到不了（任何路径都回同一份 403 裸 HTML），
# 所以这里推荐兼容网关而不是 Cohere 直连。
EMBED_PROVIDER=off
# cohere 填 https://api.cohere.com/v2；兼容网关填它的 /v1（会自动接 /embeddings）
EMBED_BASE_URL=
# 密钥只放 .env，永远不要写进任何进版本库的文件。
# 留空 = 不配远程后端，此时自动用本地确定性向量（字符 n-gram 哈希），
# 检索照常工作、召回略差；面板与日志会明写现在用的是哪一条，不装作在跑真向量。
EMBED_API_KEY=
EMBED_MODEL=
EMBED_TIMEOUT=15
VECTOR_ENABLED=true

# ---------------- 出话的锁 ----------------
# 出站内容过一遍 core/secrecy.py：密钥、.env 原文、绝对路径与内网地址、
# 别人的个资、跨人指认、提示词原文一律拦掉或抹掉。
# 这是机器执法不是又一条对模型的请求——她能向一群好友公开广播，
# 「模型自觉不说不该说的」就不再是足够保证。关掉它等于把广播能力和锁一起打开。
SECRECY_GUARD_ENABLED=true
# 出身闸（DEFLECT 档）：她说漏模型型号、服务商、或自述「我是 AI／我不是真人」时，
# 整条气泡不发原句，换一句人话顶回去。删词会留下「我其实是」这种半截话，比原句更穿帮。
# 关掉它也不会泄漏——通用锁照删那些词，只是不再换那句顶回去的话。
IDENTITY_GUARD_ENABLED=true
# 顶回去的话术表，| 分隔；留空用 core/secrecy.py 里那几句。轮换取用。
# 这里头一个「AI/模型/程序/系统」都不许出现——那等于换个方式自己把底牌念出来
IDENTITY_DEFLECT_LINES=

# ---------------- 重排：召回之后再做一次精排 ----------------
# 向量负责「别漏」（快、能扫全库，但排序粗——它没把问题和候选放一起看过），
# 重排负责「谁最相关」（准，但每条都要算一次，没法拿去扫一万条）。
# 于是两段：向量粗筛 RERANK_RECALL 条 → 重排精排出 limit 条。
# off 就退回向量原序，检索照常工作，只是排序粗一点。
RERANK_ENABLED=true
RERANK_PROVIDER=off
# 填到 /v1 即可（会自动接 /rerank）。硅基流动：https://api.siliconflow.cn/v1
RERANK_BASE_URL=
# 密钥只放 .env，永远不要写进任何进版本库的文件。
RERANK_API_KEY=
# 如 BAAI/bge-reranker-v2-m3
RERANK_MODEL=
RERANK_TIMEOUT=10
# 交给重排的候选数。重排按条计费，别贪。
RERANK_RECALL=20
# 重排分数低于这条的记忆不塞进提示词。重排器按 top_n 硬给结果，
# 问「今天天气不错」也能给你三条 0.0000 的旧事——那不是想起，是硬凑。
RERANK_FLOOR=0.05

# ===== 补齐：一直在用但这里没写过的（工程上算欠账，一次还清）=====
# 慢环认知：后台把最近的相处提炼成心得写进 MOOD.md，下一轮现场对话自然带着它
COGNITION_ENABLED=true
COGNITION_EVERY_TURNS=6
COGNITION_LOOKBACK=12
COGNITION_TIMEOUT=25
# 抽取器温度：0.0 最稳。记忆不是创作，抽出来一句「他周三要考试」不该每次都换个说法
EXTRACTOR_TEMPERATURE=0.0
# 配对：挑战有效期、过期后还认多久一句「你来晚了」、码的长度、点名哪条线上游问口令
PAIRING_TTL_SECONDS=120
PAIRING_GRACE_SECONDS=120
PAIRING_CODE_CHARS=6
PAIR_PHRASE_DEADLINE_SECONDS=5
# 留空 = 所有线路同时问、谁先落正文用谁（推荐）。点名的那条一旦没额度，这一场就只剩本地现拼
PAIR_PHRASE_ROUTE=
# 上游线路池：JSON 数组，每项 {name,base_url,api_key,model,tiers,priority,vision_model,timeout}
# api_key 支持三种写法：字面量、env:变量名、data:/路径（密钥文件）。别把真 key 写进这份文件。
# 留空就是只用 API_KEY/BASE_URL/MODEL 那一条主线。完整形状见 config.py 的 routes 字段说明。
ROUTES=
# 语音的时段偏移：深夜靠这两个数变轻变低，不换音色
TTS_RATE_BIAS=0.07
TTS_PITCH_BIAS_HZ=5
